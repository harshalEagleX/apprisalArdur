# Apprisal OCR Service — Environment Configuration
# Copy to .env and fill in values before running.

# PostgreSQL connection — Python-owned tables live here
DATABASE_URL=postgresql://postgres@localhost/ardurApprisal

# Redis — Celery broker/result backend (POST /qc/submit + GET /qc/job) AND the
# distributed Groq TPM token bucket shared across workers (Scaling Phase 1/2).
# Same instance as the Java spring.data.redis. If unset/unreachable the service
# still runs: QC falls back to synchronous /qc/process and a per-process throttle.
REDIS_URL=redis://127.0.0.1:6379/0

# Per-process SQLAlchemy pool (kept small so N Celery workers don't oversubscribe
# Postgres — Scaling Phase 2 §4.1 connection arithmetic).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# Service config
ENVIRONMENT=development
LOG_LEVEL=INFO

# Schema version used to tag extraction results for model lineage tracking
MODEL_VERSION=adaptive-1.0.0

# Ollama (used in Week 3+ for LLM extraction tier — not needed for Days 1-6)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=mistral:7b
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_TIMEOUT_TEXT=30
OLLAMA_TIMEOUT_VISION=120

# Google Cloud Vision — comparable-photo QC (SCA-27 / SCA-16V).
# Use an API key restricted to the Vision API, OR a service-account JSON path.
# VISION_ENABLED=false means zero Vision calls / zero cost.
VISION_ENABLED=false
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
VISION_MAX_PAGES=3
VISION_DETECT_MLS=false
VISION_TIMEOUT=30
