# SHAL OCR Service — Environment Configuration
# Copy to .env and fill in values before running.

# PostgreSQL connection — Python-owned tables live here
DATABASE_URL=postgresql://postgres@localhost/shal

# Redis — Celery broker/result backend (POST /qc/submit + GET /qc/job) AND the
# distributed Groq TPM token bucket shared across workers (Scaling Phase 1/2).
# Same instance as the Java spring.data.redis. If unset/unreachable the service
# still runs: QC falls back to synchronous /qc/process and a per-process throttle.
REDIS_URL=redis://127.0.0.1:6379/0

# Per-process SQLAlchemy pool (kept small so N Celery workers don't oversubscribe
# Postgres — Scaling Phase 2 §4.1 connection arithmetic).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# Service config
ENVIRONMENT=development
LOG_LEVEL=INFO

# Schema version used to tag extraction results for model lineage tracking
MODEL_VERSION=adaptive-1.0.0

# Together AI (primary LLM) — two API keys for parallel async batching.
# Both keys run simultaneously (each has its own Redis TPM token bucket).
# Leave KEY_2 blank for single-key setup.
TOGETHER_API_KEY_1=
TOGETHER_API_KEY_2=
TOGETHER_BASE_URL=https://api.together.ai/v1
TOGETHER_MODEL=openai/gpt-oss-120b
TOGETHER_TIMEOUT=60
TOGETHER_TPM_LIMIT=60000

# Groq (fallback LLM) — used when Together is unconfigured or exhausts all retries.
# Also provides the vision fallback (llama-4-scout multimodal) for the sketch reader.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TPM_LIMIT=6000

# VISION_ENABLED gates cloud vision calls (the sketch / floor-plan reader's Gemini
# vision pass). VISION_ENABLED=false means zero Gemini Vision calls / zero cost.
VISION_ENABLED=false
