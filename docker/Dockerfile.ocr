# ── Python OCR/QC service (FastAPI + Celery) ────────────────────────────────
# Build context = repo root.  Same image serves both the web API and the worker
# (command differs per compose service).
FROM python:3.11-slim
WORKDIR /app

# System libraries for the extraction tiers. requirements.txt itself is pure-Python
# (Groq does the LLM work in the cloud, PyMuPDF reads digital PDFs), but the pipeline
# shells out to / optionally imports Tesseract, Poppler, Ghostscript and OpenCV for
# scanned docs and table extraction. Installing the binaries keeps a scanned-PDF UAT
# path working; they are cheap and degrade gracefully (P-6) if a Python wrapper is absent.
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        poppler-utils \
        ghostscript \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Declared dependencies (source of truth).
COPY ocr-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# OCR extras the architecture relies on but that are not yet in requirements.txt
# (the local conda env carries them). Promote these into requirements.txt to make
# the image a 1:1 replica; pinned loosely here so the UAT image can run scanned docs.
RUN pip install --no-cache-dir \
        pdfplumber \
        pdf2image \
        pillow \
        numpy \
        pytesseract \
        opencv-python-headless \
    || echo "WARN: OCR extras failed to install — digital-PDF path still works"

COPY ocr-service/ ./
COPY docker/ocr-entrypoint.sh /usr/local/bin/ocr-entrypoint.sh
RUN chmod +x /usr/local/bin/ocr-entrypoint.sh

EXPOSE 5001
ENTRYPOINT ["/usr/local/bin/ocr-entrypoint.sh"]
CMD ["uvicorn","main:app","--host","0.0.0.0","--port","5001"]
