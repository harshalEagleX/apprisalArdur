# ── Frontend (Next.js 16 / React 19) ────────────────────────────────────────
# Build context = repo root.
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time, and these fetches run in the
# user's browser — so NEXT_PUBLIC_JAVA_URL must be the URL the BROWSER uses to reach
# the Java backend (e.g. http://localhost:8080 on a single host, or http://<uat-host>:8080),
# NOT the in-network service name.
FROM node:22-slim AS build
WORKDIR /app
ARG NEXT_PUBLIC_JAVA_URL=http://localhost:8080
ENV NEXT_PUBLIC_JAVA_URL=${NEXT_PUBLIC_JAVA_URL}
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS run
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/package.json /app/package-lock.json* ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/next.config.ts ./next.config.ts
EXPOSE 3000
CMD ["npm","run","start","--","-H","0.0.0.0","-p","3000"]
