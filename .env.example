# ============================================================
# SHAL — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Database (Neon PostgreSQL) ────────────────────────────────
# Get connection string from Neon dashboard → Project → Connection Details
DB_URL=jdbc:postgresql://<host>/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password

# ── Java Spring Boot ─────────────────────────────────────────
# JWT secret: generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_string

# Admin account (created on first boot by AdminSeeder)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeMe123!

# Session cookies — set true when behind HTTPS in production
COOKIE_SECURE=false

# ── Internal API key ──────────────────────────────────────────
# Internal service API key (used by the Java backend; also consumed by the
# future shalqc service when it is wired in).
INTERNAL_API_KEY=replace_with_strong_random_key

# Storage path for uploaded ZIP files
STORAGE_PATH=./uploads

# CORS — restrict to your real frontend origin(s) in production.
# Java (app.cors.allowed-origins):
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Force the production-readiness guard even without a 'prod' Spring profile.
# When true, the Java app REFUSES to start with any default secret / missing key.
# APP_DEPLOY_STRICT=false

# ── Optional (features degrade gracefully if unset) ───────────
# Redis — only needed for multi-node / Celery; single-node falls back to local.
# REDIS_URL=redis://localhost:6379/0

# ── Frontend (frontend/.env.local) ───────────────────────────
# NEXT_PUBLIC_JAVA_URL=http://localhost:8080
