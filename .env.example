# ============================================================
# SHAL — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Database (Neon PostgreSQL) ────────────────────────────────
# Get connection string from Neon dashboard → Project → Connection Details
DB_URL=jdbc:postgresql://<host>/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password

# ── Java Spring Boot ─────────────────────────────────────────
# JWT secret: generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_string

# Admin account (created on first boot by AdminSeeder)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeMe123!

# Session cookies — set true when behind HTTPS in production
COOKIE_SECURE=false

# ── Python OCR Service ────────────────────────────────────────
# Shared Java/Python API key. Define it once here; both services load this file.
INTERNAL_API_KEY=replace_with_strong_random_key

# URL Java uses to reach the Python service
OCR_SERVICE_URL=http://localhost:5001
OCR_TIMEOUT=180
OCR_RETRIES=2

# Storage path for uploaded ZIP files
STORAGE_PATH=./uploads

# CORS — restrict to your real frontend origin(s) in production.
# Java (app.cors.allowed-origins):
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Force the production-readiness guard even without a 'prod' Spring profile.
# When true, the Java app REFUSES to start with any default secret / missing key.
# APP_DEPLOY_STRICT=false

# ── Optional (features degrade gracefully if unset) ───────────
# Redis — only needed for multi-node / Celery; single-node falls back to local.
# REDIS_URL=redis://localhost:6379/0

# ── Python ocr-service/.env (service-specific) ────────────────
# SQLAlchemy URL — same database as the Java DB_URL above.
# DATABASE_URL=postgresql://neondb_owner:<password>@<host>/neondb?sslmode=require
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# GROQ_API_KEY=            # LLM grid/gap-fill extraction (off → deterministic readers only)
# VISION_ENABLED=false     # + GEMINI_API_KEY or GOOGLE_APPLICATION_CREDENTIALS for photo analysis
# SHAL_EXPOSE_DOCS=false   # keep the Python API docs hidden

# ── Frontend (frontend/.env.local) ───────────────────────────
# NEXT_PUBLIC_JAVA_URL=http://localhost:8080
