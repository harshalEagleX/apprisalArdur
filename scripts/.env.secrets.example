# SHAL local secrets template.
# Copy to scripts/.env.secrets (gitignored) and paste your real keys.
# init-env.sh reads this and injects the values into ocr-service/.env, so the
# keys land on every machine WITHOUT being committed to the (public) repo.
#
#   cp scripts/.env.secrets.example scripts/.env.secrets
#   # then edit scripts/.env.secrets with your real keys

GROQ_API_KEY=gsk_your_groq_key_here
GROQ_VISION_API_KEY=gsk_your_groq_vision_key_here
