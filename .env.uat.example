# ─────────────────────────────────────────────────────────────────────────────
# SHAL UAT environment — copy to .env.uat and fill in. .env.uat is git-ignored.
#   cp .env.uat.example .env.uat
# Secrets marked CHANGE-ME MUST be set to real values (compose fails fast otherwise).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──
DB_NAME=ardurApprisal
DB_USERNAME=apprisal
DB_PASSWORD=CHANGE-ME-strong-db-password

# ── Shared internal API key (Java ⇄ Python). Must be identical on both sides. ──
INTERNAL_API_KEY=CHANGE-ME-shared-internal-key

# ── JWT signing secret (64 hex chars recommended). Generate fresh — never reuse the dev default. ──
JWT_SECRET=CHANGE-ME-unique-64-char-hex-secret

# ── Seed admin (matches application.yml default user) ──
ADMIN_EMAIL=harshal@eaglexinfo.com
ADMIN_PASSWORD=CHANGE-ME-strong-admin-password

# ── Security / schema ──
COOKIE_SECURE=false           # set true when serving over HTTPS/TLS
JPA_DDL_AUTO=update           # 'validate' once the schema is baselined for UAT

# ── Groq (cloud LLM — required for SCA grid / gap-fill extraction, see P-14a) ──
GROQ_API_KEY=CHANGE-ME-groq-key
GROQ_VISION_API_KEY=CHANGE-ME-groq-vision-key

# ── Frontend → browser-facing Java URL (build-time, inlined into Next bundle) ──
# Single host: http://localhost:8080.  Remote UAT host: http://<uat-host>:8080
NEXT_PUBLIC_JAVA_URL=http://localhost:8080

# ── Grafana ──
GRAFANA_PASSWORD=admin

# ── Optional host port overrides (defaults shown) ──
# DB_PORT=5432
# REDIS_PORT=6379
# OCR_PORT=5001
# JAVA_PORT=8080
# FRONTEND_PORT=3000
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# LOG_LEVEL=INFO
