# SHALqc — ground-up QC service (SHALqc.md). Self-contained env for running this
# folder on its own device on the LAN. Gitignored — do NOT commit (real secrets).
#
# Build status: Parts 1–6 implemented (versioning, folder structure, extraction,
# normalizer, rule engine, AMC profiles). LLM subsystem (Part 10) wired,
# Together AI only (2026-07-13: Groq removed — see app/llm/client.py).

# ── Auth (SHALqc.md §9: X-API-Key middleware on everything but health/docs) ──
# Same value as INTERNAL_API_KEY in the laptop's root .env — Java sends it as the
# X-API-Key header; a mismatch = every request 401s.
INTERNAL_API_KEY=REPLACE_ME

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ── Postgres (SHALqc.md §15 runs/orders/findings). Lives on the LAPTOP. ──────
# SHARED database with the Java backend (shal_qc). SHALqc's tables have distinct
# names from every Java table, so both services coexist in one DB with no collision.
DATABASE_URL=postgresql+psycopg2://shal:shal@localhost:5432/shal_qc

# ── Redis (SHALqc.md §0/§9/§10: Celery broker + LLM content-hash cache) ──────
# Leave unset to run the synchronous /qc/process path with no LLM cache. Set it
# once a reachable Redis exists. Per §17 the LLM PII cache should use a dedicated
# DB with AUTH and 72h TTL — reflected here as db index 1 vs the broker's db 0.
# REDIS_URL=redis://localhost:6379/0
# REDIS_LLM_CACHE_URL=redis://localhost:6379/1

LOG_LEVEL=INFO

# Bind to all interfaces so the laptop's Java can reach it:
#   uvicorn app.main:app --host 0.0.0.0 --port 5002
# (port 5002 to avoid clashing with the legacy ocr-service on 5001.)

# ── LLM — single provider, Together AI (2026-07-13: Groq removed entirely; ─────
# see app/llm/client.py / app/llm/together_pool.py for why). Two keys, governed
# by a per-key token-bucket + in-flight limiter (TogetherPool) so calls never
# get sent faster than the account tier can actually take.
TOGETHER_API_KEY_1=REPLACE_ME
TOGETHER_API_KEY_2=REPLACE_ME
TOGETHER_MODEL=openai/gpt-oss-120b
# Set these from your real Together tier limits. Default max-inflight is 2 (× keys)
# — measured 2026-07-17: a higher value triggers 429s whose retry-backoffs make a
# run BOTH slower and lossier (ESGA 120s/18 fallbacks at 8 vs 22s/0 at 2). Raise
# only if your tier's measured request rate can actually take it.
# TOGETHER_TPM_BUDGET_PER_KEY=60000
# TOGETHER_MAX_INFLIGHT_PER_KEY=2
# TOGETHER_TIMEOUT_S=45

# LLM budget guardrail (SHALqc.md §10 / CORE §4.0): ≤ 28 calls per order.
LLM_MAX_CALLS_PER_ORDER=28
LLM_CACHE_TTL_HOURS=72
